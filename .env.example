# ==============================================================
#  .env.example — Backend Yamil / Yamila Potel
# --------------------------------------------------------------
#  ESTE archivo es una PLANTILLA. Se copia como ".env" y se
#  edita con los valores reales.
#
#  .env NUNCA se sube a GitHub (lo impide .gitignore).
#  .env.example SÍ se sube: no tiene valores reales, solo
#  muestra qué variables existen y cómo van escritas.
#
#  Cómo se usa en el código (cuando haya server.js):
#      require('dotenv').config();
#      var url = process.env.GAS_URL_EXEC;
# ==============================================================


# ---------------------------------------------------------------
#  SERVIDOR LOCAL (server.js) — solo para desarrollo
# ---------------------------------------------------------------
# Puerto donde server.js sirve la web en tu navegador.
# Abrir después: http://localhost:3000

PORT=3000


# ---------------------------------------------------------------
#  GOOGLE APPS SCRIPT (el backend) — NO necesita claves
# ---------------------------------------------------------------
# El backend corre dentro de Google con los permisos de la
# cuenta. No hay API key, ni contraseña, ni token que poner
# acá. Lo único que hace falta es la URL pública del web app,
# que ES pública por diseño (no es un secreto).

GAS_URL_EXEC=
# Ejemplo (no es real):
# GAS_URL_EXEC=https://script.google.com/macros/s/AKfy.../exec


# ---------------------------------------------------------------
#  GOOGLE SHEET — tampoco necesita claves
# ---------------------------------------------------------------
# La hoja "YP - Base de datos" se accede desde el propio GAS.
# Este ID solo sirve si el script NO está vinculado a la hoja.

SHEET_ID=


# ---------------------------------------------------------------
#  FIREBASE (panel admin — Fase 4)
# ---------------------------------------------------------------
# La config web de Firebase (apiKey, authDomain, etc.) es
# PÚBLICA por diseño: no es un secreto. La seguridad está en
# que existe una sola cuenta de usuario y en que Apps Script
# verifica el token.
#
# Lo que SÍ es secreto es la CUENTA DE SERVICIO (si algún día
# se usa Firebase Admin desde Node): ese JSON va en
# serviceAccount.json y está en .gitignore.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=


# ---------------------------------------------------------------
#  HOSTING / VPS (si se usa — Fase de despliegue)
# ---------------------------------------------------------------
# Solo si el sitio se sube por script (rsync, FTP, etc.).

HOST=
USER_SSH=
# PASSWORD_SSH=      <-- mejor usar clave SSH, no contraseña


# ---------------------------------------------------------------
#  WHATSAPP (no es secreto — está en el front a propósito)
# ---------------------------------------------------------------
# El número de WhatsApp vive en js/contacto.js y
# js/diagnostico.js porque wa.me es un link público.
WHATSAPP_NUMBER=1139053672
